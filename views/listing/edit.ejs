<% layout("/layouts/boilerplate") -%>
<div class="row mb-2 mt-2">
    <div class="col-8 offset-2">
        <form method="POST" action="/listing/<%= Onelisting._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-lebel">Title</label>
            <input type="text" value="<%= Onelisting.title %>" name="listing[title]" class="form-control" required> 
            <div class="invalid-feedback">Title is required.</div>
        </div>
        
        <div class="mb-3">
            <label for="description" class="form-lebel">Description</label>
            <textarea name="listing[description]" class="form-control" required><%= Onelisting.description %></textarea> 
            <div class="invalid-feedback">Description is required.</div>
        </div>

        <div class="mb-3">
            <label for="url" class="form-lebel">Please uplpad image</label>
            <input type="file" name="listing[image]" class="form-control"> 
        </div>

        <div class="mb-3">
            <label for="location" class="form-lebel">Location</label>
            <input type="text" value="<%= Onelisting.location %>" name="listing[location]" class="form-control" required>
            <div class="invalid-feedback">Location is required</div>
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-lebel">Price</label>
                <input type="number" value="<%= Onelisting.price %>" name="listing[price]" class="form-control" required> 
                <div class="invalid-feedback">Price is required.</div>
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class="form-lebel">Country</label>
                <input type="text" value="<%= Onelisting.country %>" name="listing[country]" class="form-control" required> 
                <div class="invalid-feedback">Country is required</div>
            </div>
        </div>   
        <button type="submit" class="btn btn-dark">Update</button> <br>
    </form>
</div>
</div>