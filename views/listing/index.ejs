<% layout("/layouts/boilerplate") -%>
<body>
    <!-- <form method="GET" action="/listing/new">
        <button>Create New Listing</button>
    </form> -->

    <style>
        #filters{
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
        }
        .filter{
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top: 11px;
            opacity: 0.7;
            transition: all;
            transition-duration: 0.4s;
        }
        .filter p{
            font-size: 13px;
        }
        .filter:hover{
            opacity: 1;
            cursor: pointer;
        }
    </style>
    <div id="filters" class="mt-3 mb-2">
        <div class="filter">
            <div><i class="fa-solid fa-house"></i></div>
            <p>Home</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Pool</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed-pulse"></i></div>
            <p>Private room</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed-pulse"></i></div>
            <p>Beachfront</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-tree-city"></i></div>
            <p>Tree city</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-tractor"></i></div>
            <p>Farm house</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-sailboat"></i></div>
            <p>Boats</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-landmark-dome"></i></div>
            <p>Domes</p>
        </div>
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <%for(listing of allListing){%> 
            <a href="/listing/<%= listing._id %>" class="listing-links">
                <div class="card">
                    <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_img" style="height: 20rem;">
                    <div class="card-img-overlay">
                        
                    </div>
                    <div class="card-body mb-3">
                    <p class="card-text"> <b><%= listing.title %></b><br>
                        &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
                    </p>
                    </div>
                </div>
            </a>
        <%}%>
    </div>
</body>